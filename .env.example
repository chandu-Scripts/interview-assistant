# Copy to .env (git-ignored). Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-flash-latest
# Cost tracking (all optional)
# BUDGET_USD=5            # cap in USD; overlay cost turns amber at 80% and red when exceeded
# BUDGET_SCOPE=session    # session | day | month
# BUDGET_HARD_STOP=false  # true = refuse new answers once the budget is exceeded
# PRICING_FILE=C:\path\to\prices.json   # override built-in rates (see cost/pricing.py)
# History (questions + answers stored locally in %APPDATA%\InterviewAssistant\history.db)
# HISTORY_ENABLED=true
# HISTORY_RETENTION_DAYS=30   # auto-delete sessions older than this at startup
# Privacy (all optional)
# INCOGNITO=false             # start with nothing saved (also toggleable in the app / tray)
# REDACT_PII=true             # mask emails, phones, cards, API keys before sending to AI providers
# REQUIRE_CONSENT=true        # recording notice before the first capture
# HOTKEY_PRESENTATION=ctrl+alt+p   # toggle presentation mode (empty = disabled)
# HOTKEY_OVERLAY=ctrl+alt+o        # show/hide the overlay (empty = disabled)
# Setup / automation
# SKIP_ONBOARDING=true   # never show the first-run wizard (automation, managed installs)
# DATA_DIR=D:\ia-data    # where settings.json, history.db and usage.jsonl live
